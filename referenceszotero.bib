	note = {\_eprint: https://onlinelibrary.wiley.com/doi/pdf/10.3982/ECTA7195},
	keywords = {Bias, media ownership, text categorization},
	pages = {35--71},
}

@article{hansen_transparency_2018,
	title = {Transparency and {Deliberation} {Within} the {FOMC}: {A} {Computational} {Linguistics} {Approach}*},
	volume = {133},
	issn = {0033-5533},
	shorttitle = {Transparency and {Deliberation} {Within} the {FOMC}},
	url = {https://doi.org/10.1093/qje/qjx045},
	doi = {10.1093/qje/qjx045},
	abstract = {How does transparency, a key feature of central bank design, affect monetary policy makers’ deliberations? Theory predicts a positive discipline effect and negative conformity effect. We empirically explore these effects using a natural experiment in the Federal Open Market Committee in 1993 and computational linguistics algorithms. We first find large changes in communication patterns after transparency. We then propose a difference-in-differences approach inspired by the career concerns literature, and find evidence for both effects. Finally, we construct an influence measure that suggests the discipline effect dominates.},
	number = {2},
	urldate = {2025-04-04},
	journal = {The Quarterly Journal of Economics},
	author = {Hansen, Stephen and McMahon, Michael and Prat, Andrea},
	month = may,
	year = {2018},
	pages = {801--870},
}

@article{djourelova_media_2024,
	title = {Media {Slant} and {Public} {Policy} {Views}},
	volume = {114},
	issn = {2574-0768},
	url = {https://www.aeaweb.org/articles?id=10.1257/pandp.20241005},
	doi = {10.1257/pandp.20241005},
	abstract = {We study how exposure to partisan news channels (Fox News and MSNBC) affects individual views on four policy issues: climate change, gun rights, abortion, and immigration. First, using GPT to annotate news transcripts, we document large differences in the way the two networks cover these issues. Second, exploiting exogenous variation in viewership due to channels' positions in cable lineups, we show that exposure to Fox News (MSNBC) is associated with more conservative (progressive) views, even when controlling for self-reported ideology and party affiliation. Our findings indicate that partisan media contribute to the rise of political polarization in the United States.},
	language = {en},
	urldate = {2025-04-03},
	journal = {AEA Papers and Proceedings},
	author = {Djourelova, Milena and Durante, Ruben and Motte, Elliot and Patacchini, Eleonora},
	month = may,
