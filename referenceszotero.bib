@incollection{hasisi_what_2023,
	address = {Cambridge},
	title = {What {Do} {We} {Know} about {Proactive} {Policing}’s {Effects} on {Crime} and {Community}?: {Drawing} {Conclusions} from a {National} {Academies} of {Sciences}, {Engineering}, and {Medicine} {Report}},
	isbn = {978-1-108-84035-4},
	shorttitle = {What {Do} {We} {Know} about {Proactive} {Policing}’s {Effects} on {Crime} and {Community}?},
	url = {https://www.cambridge.org/core/books/future-of-evidencebased-policing/what-do-we-know-about-proactive-policings-effects-on-crime-and-community/9F77976C8A81DD69E75E378C4543E806},
	doi = {10.1017/9781108885737.008},
	abstract = {In this chapter we summarize the findings of the National Academy of Sciences, Engineering, and Medicine report on proactive policing, focusing on impacts on crime and communities. We begin the paper with a description of how proactive policing was defined in the report, and a summary of the wide scale use of proactive policing approaches in American police agencies. We then turn to summaries of the evidence on crime control and community outcomes. The report concluded that there was sufficient scientific evidence to support the adoption of many proactive policing practices. We argue that successful prevention programs rely on greater focusing of police resources, and expansion of the tools of policing (for crime prevention). The Committee also found that crime prevention outcomes can often be obtained without producing negative community reactions, and that some community-based strategies have begun to show evidence of improving the relations between the police and public. In concluding, we argue that future proactive policing programs should seek to maximize both crime prevention and positive community outcomes and suggest how this can be done given the report’s findings.},
	urldate = {2024-12-09},
	booktitle = {The {Future} of {Evidence}-{Based} {Policing}},
	publisher = {Cambridge University Press},
	author = {Weisburd, David and Braga, Anthony A. and Majmundar, Malay},
	editor = {Hasisi, Badi and Weisburd, David and Perry, Gali and Jonathan-Zamir, Tal},
	year = {2023},
	keywords = {Broken Windows Policing, Community Oriented Policing, Focused Deterrence, Hot Spots Policing, NAS (National Academies of Sciences, Medicine and Engineering), Narrative Review, Predictive Policing, Proactive Policing, Problem Oriented Policing, Procedural Justice Policing, Repeat Offender Programs, SQF (Stop, Question and Frisk), Standard Model of Policing, Third Party Policing},
	pages = {107--125},
}

@article{grogger_effects_2002,
