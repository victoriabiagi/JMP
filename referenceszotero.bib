}

@incollection{valentini_disuguaglianza_2018,
	title = {Disuguaglianza, povertà e criminalità. {Una} ricognizione in ambito italiano},
	isbn = {978-88-255-1445-2},
	doi = {10.4399/97888255144523},
	abstract = {La possibilità di stabilire una relazione, anche in termini causali, tra disuguaglianza nella distribuzione dei redditi e criminalità è un tema che ha coinvolto nel tempo numerosi scienziati sociali ed economisti (Rufrancos et al., 2013). [...] È interessante, quindi, indagare quanto sia la disuguaglianza in sé (e la connessa riduzione della coesione sociale) o la povertà (e la connessa necessità di fronteggiare situazioni di deprivazione) a creare la condizioni affinché un tessuto sociale sia più o meno predisposto a generare tassi crescenti di criminalità (Webster e Kingston, 2014).
All’interno del tema “economia e criminalità”, l’Italia evidenzia alcune specificità, le cui radici affondano nel processo di nascita e sviluppo dello Stato-nazione: in primis, elevato tasso di economia sommersa e elevato tasso di criminalità organizzata. Inoltre, è ben noto l’elevato livello di frammentazione che contraddistingue il territorio italiano, con accentuate specificità locali (regionali) che contribuiscono a creare un insieme molto vario di “sistemi sociali”. Partendo da queste premesse, il lavoro che si propone analizza congiuntamente, per il caso italiano, la relazione tra squilibri distributivi (disuguaglianza/povertà) e criminalità, da un lato, e differenze regionali – e loro evoluzione nel tempo – dall’altro. L’analisi, condotta utilizzando l’Archivio Unico degli Indicatori Regionali dell’ISTAT e i dati sulla distribuzione del reddito di Banca d’Italia per gli ultimi decenni, fornisce numerosi elementi di riflessione. Emerge, infatti, con chiarezza che le variabili che interpretano la criminalità presentano una correlazione positiva con la disuguaglianza di reddito: peggiore è la distribuzione del reddito, maggiore è l’incidenza di fatti criminali. Per quanto riguarda la povertà, una correlazione maggiore è individuata per quel che concerne i reati associativi; entrambi i fenomeni sembrano essere di pertinenza marcata (ma non esclusiva) del meridione d’Italia. Infine, focalizzandoci sulla questione giovanile, l’analisi econometrica ci permette di individuare con chiarezza come sia la stessa mancanza di prospettive (disoccupazione giovanile) a influenzare significativamente la propensione degli adolescenti a delinquere (criminalità minorile).},
	booktitle = {Disuguaglianze, giustizia, legalita'. {Tendenze} in atto e azioni possibili.},
	publisher = {Aracne},
	author = {Valentini, Enzo and Clementi, Fabio and Schettino, Francesco},
	month = may,
	year = {2018},
}

