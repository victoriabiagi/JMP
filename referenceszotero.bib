	keywords = {Media, Political Processes: Rent-seeking, Lobbying, Elections, Legislatures, and Voting Behavior, Micro-Based Behavioral Economics: Role and Effects of Psychological, Emotional, Social, and Cognitive Factors on Decision Making, Entertainment},
	pages = {684--689},
}

