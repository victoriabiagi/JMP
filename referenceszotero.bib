}

@article{bracken_generation_1989,
	title = {The {Generation} of {Spatial} {Population} {Distributions} from {Census} {Centroid} {Data}},
	volume = {21},
	issn = {0308-518X},
	url = {https://doi.org/10.1068/a210537},
