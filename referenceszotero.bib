@misc{barilari_political_2025,
	address = {Rochester, NY},
	type = {{SSRN} {Scholarly} {Paper}},
	title = {Political {Rhetoric} and {Racial} {Discrimination} in {Arrests} for {Drugs}},
	url = {https://papers.ssrn.com/abstract=5134609},
	doi = {10.2139/ssrn.5134609},
	abstract = {This paper examines how political rhetoric shapes law enforcement behavior. We analyze monthly arrest data from 1,420 police agencies across 38 U.S. states between January 1981 and December 1992, a period when U.S. presidents intensified anti-drug messaging, particularly targeting crack cocaine, which the media disproportionately linked to Black communities. We construct a novel measure of national rhetoric intensity and show that it received greater coverage in local newspapers in counties where Republicans and Democrats had comparable support, using this differential media exposure as a proxy for local susceptibility to the rhetoric. Our findings reveal that greater exposure to this rhetoric led to a significant rise in drug possession arrests among Black individuals, with no corresponding increase for White individuals, thereby widening racial disparities in arrests.},
	language = {en},
	urldate = {2025-12-01},
	publisher = {Social Science Research Network},
	author = {Barilari, Francesco and Zambiasi, Diego},
	month = feb,
	year = {2025},
	keywords = {Crack cocaine, J15, JEL codes: D72, K42, P00, Political rhetoric, Racial discrimination},
}

@article{leroy_understanding_2024,
	title = {Understanding policing in the aftermath of gun violence: {Examining} investigatory stops and crime in {Chicago}},
	volume = {234},
	issn = {0047-2727},
	shorttitle = {Understanding policing in the aftermath of gun violence},
	url = {https://www.sciencedirect.com/science/article/pii/S0047272724000537},
	doi = {10.1016/j.jpubeco.2024.105117},
	abstract = {I examine investigatory stops conducted by Chicago police officers following recent gun violence. I use a staggered difference-in-differences design to dynamically compare stops between neighboring police beats. In the immediate aftermath of gun violence, I find a rise in total stops that corresponds with a decline in index crime incidents and results in more seized weapons and/or contraband. Over the next month, officers continue to conduct additional stops, but these stops prove unproductive in yielding illicit goods, and seemingly have no impact on crime. Stops resulting in enforcement action persist three months after gun violence. Non-White stops in regions with considerable gang concentration account for much of the baseline rise in total stops.},
	urldate = {2025-12-01},
	journal = {Journal of Public Economics},
	author = {LeRoy, William},
	month = jun,
	year = {2024},
	keywords = {Chicago, Crime, Gun violence, Investigatory stops},
	pages = {105117},
}

